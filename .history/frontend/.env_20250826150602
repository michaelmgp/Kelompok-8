# Frontend Environment Variables

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8081
NEXT_PUBLIC_API_TIMEOUT=10000
NEXT_PUBLIC_API_RETRIES=3

# Next.js Configuration
NEXT_PUBLIC_APP_NAME=AI Career Assistant
NEXT_PUBLIC_APP_VERSION=1.0.0

# Development
NODE_ENV=development
 
# Canister (frontend public vars - no quotes)
## Canister IDs deployed to local dfx (updated after `dfx deploy`)
# Identity canister (holds user profiles)
NEXT_PUBLIC_IDENTITY_CANISTER_ID=uqxf-5h777-77774-qaaaa-caiq
# Job canister (application data / main app canister)
NEXT_PUBLIC_JOB_CANISTER_ID=umunu-kh777-77774-qaaca-cai
# Chat canister
NEXT_PUBLIC_CHAT_CANISTER_ID=u6s2n-gx777-77774-qaaba-cai
# Agent canister
NEXT_PUBLIC_AGENT_CANISTER_ID=uxrrr-q7777-77774-qaaaq-cai
# App canister id (used by the app / ii redirect for the app context)
NEXT_PUBLIC_APP_CANISTER_ID=umunu-kh777-77774-qaaca-cai
# Internet Identity canister id (leave empty to use public identity.ic0.app)
# When developing locally with a deployed Internet Identity, set this to your
# local II canister id so the app can open the local authorize URL in a popup.
NEXT_PUBLIC_II_CANISTER_ID=uxrrr-q7777-77774-qaaaq-cai

# When running a local Internet Identity served via a gateway (for example
# dfx's local HTTP interface), set the gateway canister id to the value shown
# by `dfx deploy` so the authorize URL can be built like:
# http://127.0.0.1:4943/?canisterId=<GATEWAY>&id=<II_CANISTER>#authorize?... 
# Replace the value below with the gateway id printed by dfx (example: uzt4z-...)
NEXT_PUBLIC_II_GATEWAY_CANISTER_ID=uzt4z-lp777-77774-qaabq-cai

# Full gateway entrypoint for local canister HTTP (use the agent_contract canister as the gateway root)
# Tail the string with '&id=' so the server can append the II canister id and produce
# a final URL like: http://127.0.0.1:8000/?canisterId=ulvla-h7777-77774-qaacq-cai&id=<II_CANISTER>#authorize?... 
NEXT_PUBLIC_II_GATEWAY_URL=http://127.0.0.1:8000/?canisterId=uzt4z-lp777-77774-qaabq-cai&id=

# Per-canister gateway entrypoints (set by `dfx deploy` - used by the frontend/runtime helpers)
# These point at the same local HTTP gateway (gateway canister id = uzt4z-...) and specify
# the inner canister id for convenience. The code will parse these and prefer gateway-style
# URLs when running locally.
NEXT_PUBLIC_AGENT_GATEWAY_URL=http://127.0.0.1:8000/?canisterId=uzt4z-lp777-77774-qaabq-cai&id=umunu-kh777-77774-qaaca-cai
NEXT_PUBLIC_CHAT_GATEWAY_URL=http://127.0.0.1:8000/?canisterId=uzt4z-lp777-77774-qaabq-cai&id=ulvla-h7777-77774-qaacq-cai
NEXT_PUBLIC_IDENTITY_GATEWAY_URL=http://127.0.0.1:8000/?canisterId=uzt4z-lp777-77774-qaabq-cai&id=uxrrr-q7777-77774-qaaaq-cai
NEXT_PUBLIC_JOB_GATEWAY_URL=http://127.0.0.1:8000/?canisterId=uzt4z-lp777-77774-qaabq-cai&id=u6s2n-gx777-77774-qaaba-cai

# Wallet canister created for your local identity by `dfx deploy` (useful for local payments/ops)
NEXT_PUBLIC_WALLET_CANISTER_ID=uqqxf-5h777-77774-qaaaa-cai

# Local replica host (set when running a local dfx replica). When set, the
# frontend will prefer the local replica for actor calls and will build local
# II authorize URLs. Set to http://127.0.0.1:8000 for local development.
NEXT_PUBLIC_DFX_HOST=http://127.0.0.1:8000
# Ingress TTL (ms) for development to avoid ingress_expiry errors when clock skew exists
NEXT_PUBLIC_INGRESS_TTL_MS=600000


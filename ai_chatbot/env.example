# --- LLM Configuration ---
# Choose your model type: "grok" (lightweight & recommended) or "openai" (cloud)
MODEL_TYPE=grok

# --- Grok API (Lightweight & Fast) ---
GROK_API_KEY=your_grok_api_key_here
GROK_MODEL=llama3-8b-8192

# --- OpenAI (Cloud Models) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# --- ICP Integration ---
# Internet Computer canister IDs for identity and chat contracts
ICP_IDENTITY_CANISTER_ID=your_identity_canister_id_here
ICP_CHAT_CANISTER_ID=your_chat_canister_id_here
ICP_NETWORK_URL=https://ic0.app

# --- Server Configuration ---
# CORS: Allow multiple origins separated by commas, or use * for all
# For development, include both common ports
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:3000,http://127.0.0.1:5000

# --- uAgents / Chat Protocol ---
AGENT_NAME=job_chat_agent
# If you haven't made a seed yet, leave this blank (agent will use a temporary seed).
AGENT_SEED=
# Mailbox makes your agent discoverable in Agentverse (optional but recommended for judging)
MAILBOX_URL=https://agentverse.ai
MAILBOX_KEY=
AGENT_PUBLIC_ENDPOINT=

# Explorer Agent Configuration

# Server Configuration
EXPLORER_AGENT_PORT=8000
EXPLORER_AGENT_DEBUG=false
EXPLORER_AGENT_HOST=0.0.0.0

# Scraping Configuration
EXPLORER_AGENT_RATE_LIMIT=2
EXPLORER_AGENT_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
EXPLORER_AGENT_MAX_RETRIES=3
EXPLORER_AGENT_TIMEOUT=30

# Job Sources Configuration
EXPLORER_AGENT_ENABLE_LINKEDIN=true
EXPLORER_AGENT_ENABLE_INDEED=true
EXPLORER_AGENT_ENABLE_GLASSDOOR=true
EXPLORER_AGENT_ENABLE_STACKOVERFLOW=true

# AI Processing Configuration
EXPLORER_AGENT_AI_ENABLED=true
EXPLORER_AGENT_AI_MODEL=gpt-3.5-turbo
EXPLORER_AGENT_AI_API_KEY=your_openai_api_key_here

# Database Configuration (Optional)
EXPLORER_AGENT_REDIS_URL=redis://localhost:6379
EXPLORER_AGENT_DB_URL=sqlite:///explorer_agent.db

# Logging Configuration
EXPLORER_AGENT_LOG_LEVEL=INFO
EXPLORER_AGENT_LOG_FILE=explorer_agent.log


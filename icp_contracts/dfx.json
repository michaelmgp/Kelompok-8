{
  "version": 1,
  "canisters": {
    "job_contract": {
      "type": "motoko",
      "main": "src/job_contract.mo",
      "candid": "src/job_contract.did"
    },
    "identity_contract": {
      "type": "motoko", 
      "main": "src/identity_contract.mo",
      "candid": "src/identity_contract.did"
    },
    "chat_contract": {
      "type": "motoko",
      "main": "src/chat_contract.mo",
      "candid": "src/chat_contract.did"
    }
  },
  "networks": {
    "local": {
      "bind": "127.0.0.1:8000",
      "type": "ephemeral"
    },
    "ic": {
      "providers": ["https://ic0.app"],
      "type": "persistent"
    },
    "teammate": {
      "providers": ["https://ic0.app"],
      "type": "persistent"
    }
  },
  "output_env_file": ".env",
  "defaults": {
    "build": {
      "packtool": ""
    }
  }
}